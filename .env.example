# skimsearch talks to an OpenAI-compatible API. The default base URL is AtmoRouter.
# Keys from https://atmorouter.dev look like ar- followed by hex.
ATMOROUTER_API_KEY=ar-your-key-here

# Aliases. ATMOROUTER_API_KEY is used when more than one of these is set.
# SKIMSEARCH_API_KEY=ar-your-key-here
# OPENAI_API_KEY=ar-your-key-here

# Override the base URL to use any OpenAI-compatible endpoint.
# The value includes the /v1 prefix for both chat completions and Anthropic messages.
SKIMSEARCH_BASE_URL=https://atmorouter.dev/v1

# Also honored when SKIMSEARCH_BASE_URL is unset:
# OPENAI_BASE_URL=https://atmorouter.dev/v1

# Catalogue model id. List the models on your key:
#   curl "$SKIMSEARCH_BASE_URL/models" -H "Authorization: Bearer $ATMOROUTER_API_KEY"
SKIMSEARCH_MODEL=atmo/deepseek-v4.1-flash

# openai -> POST {base}/chat/completions
# anthropic -> POST {base}/messages   (AtmoRouter accepts both)
SKIMSEARCH_API_STYLE=openai

# Token budget for a search deck. Each returned card is trimmed to fit.
# SKIMSEARCH_BUDGET=700
# SKIMSEARCH_CARD_TOKENS=140
# SKIMSEARCH_TIMEOUT=60

# Embeddings are optional. Leave this unset unless your provider implements
# POST {base}/embeddings. AtmoRouter's documented APIs are chat completions
# and Anthropic messages, so semantic mode uses the chat API unless you point
# SKIMSEARCH_BASE_URL at an embeddings-capable endpoint and set a model here.
# SKIMSEARCH_EMBED_MODEL=text-embedding-3-small
